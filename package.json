{
  "name": "surpluslink",
  "version": "1.0.0",
  "private": true,
  "description": "Connects restaurants with surplus food to volunteers who collect it.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "concurrently -n api,web -c green,blue \"node --watch --disable-warning=ExperimentalWarning server/index.js\" \"vite\"",
    "test": "node --disable-warning=ExperimentalWarning --test tests/rules.test.js tests/api.test.js"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
